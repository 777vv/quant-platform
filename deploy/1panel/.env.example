# 1Panel 部署环境变量样例：复制为 .env 后填写（与 deploy/1panel/docker-compose.yml 配套）
# 全部变量都会在 1Panel「编排」创建页面被自动识别成表单，可直接在面板里填、不必手改文件。

# ---- MySQL（1Panel「数据库」里创建的库与账号）----
DB_NAME=quant
DB_USER=quant
DB_PASSWORD=change_me_app
# MySQL 容器名或服务名（1Panel 商店装的形如 1Panel-mysql-XXXX；在本机 1Panel → 容器 列表里复制）
DB_HOST=1Panel-mysql-XXXX
DB_PORT=3306

# ---- Redis（1Panel 商店装的 Redis 默认带密码，密码在应用详情页）----
REDIS_HOST=1Panel-redis-XXXX
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 应用 ----
# 对外端口（默认只在 127.0.0.1 上监听，由 1Panel 网站反向代理转发；改成 8080 可直连）
APP_PORT=8080
# 首次启动创建的管理员（留空则用 admin / admin123，公网服务器务必改掉）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
# JVM 参数（1~2G 内存的机器建议 -Xms256m -Xmx768m）
JAVA_OPTS=-Xms512m -Xmx1024m -Duser.timezone=Asia/Shanghai

# ---- 可选：智谱 API Key（AI 助手；也可启动后在【平台配置 → AI 模型配置】里填）----
ZHIPU_API_KEY=
