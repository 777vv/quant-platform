<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.quant</groupId>
    <artifactId>quant-platform</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>quant-platform</name>
    <description>个人量化投资助手（单应用多模块）</description>

    <modules>
        <module>quant-common</module>
        <module>quant-system</module>
        <module>quant-fund</module>
        <module>quant-strategy</module>
        <module>quant-ai</module>
        <module>quant-web</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 版本兼容矩阵：M1-01 实测确认（Maven Central，2026-09） -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <sa-token.version>1.46.0</sa-token.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <redisson.version>4.7.0</redisson.version>
        <p3c-pmd.version>2.1.1</p3c-pmd.version>
        <skipPmd>false</skipPmd>
    </properties>

    <dependencies>
        <!-- 全模块继承：仅编译期使用 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MP 3.5.9+ 分页等拦截器拆分至此 artifact -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.quant</groupId>
                <artifactId>quant-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.quant</groupId>
                <artifactId>quant-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.quant</groupId>
                <artifactId>quant-fund</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.quant</groupId>
                <artifactId>quant-strategy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.quant</groupId>
                <artifactId>quant-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>1.15.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 阿里巴巴 Java 开发手册静态检查（技术文档 12 节）：p3c-pmd 仅兼容 PMD 6，
                 maven-pmd-plugin 3.21.2 默认 PMD 6.55.0，二者匹配；-DskipPmd=true 可跳过 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.21.2</version>
                <configuration>
                    <rulesets>
                        <ruleset>rulesets/java/ali-comment.xml</ruleset>
                        <ruleset>rulesets/java/ali-concurrent.xml</ruleset>
                        <ruleset>rulesets/java/ali-constant.xml</ruleset>
                        <ruleset>rulesets/java/ali-exception.xml</ruleset>
                        <ruleset>rulesets/java/ali-flowcontrol.xml</ruleset>
                        <ruleset>rulesets/java/ali-naming.xml</ruleset>
                        <ruleset>rulesets/java/ali-oop.xml</ruleset>
                        <ruleset>rulesets/java/ali-orm.xml</ruleset>
                        <ruleset>rulesets/java/ali-other.xml</ruleset>
                        <ruleset>rulesets/java/ali-set.xml</ruleset>
                    </rulesets>
                    <printFailingErrors>true</printFailingErrors>
                    <skip>${skipPmd}</skip>
                    <!-- PMD 解析级别固定 17：p3c 2.1.1 仅兼容 PMD 6（最高识别到 Java 19 语法），
                         若跟随 maven.compiler.target=21 会在 targetJdk 校验时报
                         "Unsupported targetJdk value '21'"；本项目源码未用 Java 18+ 语法，
                         17 级解析完整覆盖，编译目标（release=21）不受此影响 -->
                    <targetJdk>17</targetJdk>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.alibaba.p3c</groupId>
                        <artifactId>p3c-pmd</artifactId>
                        <version>${p3c-pmd.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
