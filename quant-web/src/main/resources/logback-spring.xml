<?xml version="1.0" encoding="UTF-8"?>
<!-- 技术文档 14.1：app/error/eastmoney 三文件，按天+100MB 滚动，生产异步写入，traceId 贯穿 -->
<configuration scan="true" scanPeriod="30 seconds">

    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-N/A}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] [%X{traceId:-N/A}] %cyan(%logger{36}) - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件类 appender 仅 prod 使用（避免 dev 下"appender 未引用"告警） -->
    <springProfile name="prod">

        <appender name="APP" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/app.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="ASYNC_APP" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>1024</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="APP"/>
        </appender>

        <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/error.log</file>
            <filter class="ch.qos.logback.classic.filter.LevelFilter">
                <level>ERROR</level>
                <onMatch>ACCEPT</onMatch>
                <onMismatch>DENY</onMismatch>
            </filter>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="EASTMONEY" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/eastmoney.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/eastmoney.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <!-- 外部数据源专用 logger（additivity=false：不重复进主日志） -->
        <logger name="com.quant.fund.client" level="DEBUG" additivity="false">
            <appender-ref ref="EASTMONEY"/>
        </logger>

        <!-- AI 工具调用日志（V4.5）：每次模型请求调用工具的名称/入参/结果摘要，
             一行一次批量调用、多轮对话多行，grep "AI-TOOL" 即可还原一轮对话的工具链 -->
        <appender name="AITOOL" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/ai-tool.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/ai-tool.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <logger name="com.quant.ai.tool" level="INFO" additivity="false">
            <appender-ref ref="AITOOL"/>
        </logger>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_APP"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <!-- V6.43 用户要求：业务包不再开 DEBUG（否则 com.quant.fund.mapper 的 MyBatis SQL 参数
             会全量写进 app.log）；东财请求诊断仍由上面专用 eastmoney.log（DEBUG，additivity=false）承载。
             临时要业务 DEBUG 时在 yml 的 logging.level 里定向放开某个包即可。 -->
        <logger name="com.quant" level="INFO" additivity="true"/>

    </springProfile>

    <springProfile name="dev">
        <!-- V6.43：dev 与 prod 对齐——东财请求诊断走专用 eastmoney.log（DEBUG，additivity=false），
             不再随 root 淹进控制台；root 由 DEBUG 收回 INFO（此前 root=DEBUG 会把 MyBatis SQL 参数、
             Spring MVC 调试全量打进控制台，用户明确要求避免） -->
        <appender name="EASTMONEY" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/eastmoney.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/eastmoney.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>100MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <logger name="com.quant.fund.client" level="DEBUG" additivity="false">
            <appender-ref ref="EASTMONEY"/>
        </logger>

        <!-- dev 下工具调用日志也单独成文件；不再额外挂 CONSOLE（dev 的 root 本身就是 CONSOLE，
             挂了会因 additivity 观感混乱出现"像重复"的输出；要看控制台直接 tail ai-tool.log 或看 root 日志） -->
        <appender name="AITOOL" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/ai-tool.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/ai-tool.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <logger name="com.quant.ai.tool" level="INFO" additivity="false">
            <appender-ref ref="AITOOL"/>
        </logger>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
